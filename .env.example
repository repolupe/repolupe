# Copy to .env and adjust. All variables are documented in .env.example.full.

# Initial password of the admin account "admin", created on first startup when there are no users (optional,
# defaults to repolupe123). It has to be changed on the first login.
# ADMIN_PASSWORD=

# Encrypts repository access tokens and LLM API keys (REQUIRED), e.g. from: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
