# Copy to .env and adjust. docker-compose.yml falls back to these defaults if .env is missing.

# Initial password of the admin account "admin", created on first startup when there are no users (optional,
# defaults to repolupe123). It has to be changed on the first login.
# ADMIN_PASSWORD=

# Encrypts repository access tokens and LLM API keys (REQUIRED). Any random string of at least 32 characters,
# e.g. generated with: openssl rand -hex 32
# Changing it later makes stored tokens unreadable, they then have to be entered again.
TOKEN_ENCRYPTION_KEY=

# Shown to users (optional)
INSTANCE_NAME=Repolupe

# Text recognition (OCR) for scanned pages in documents (optional): none, tesseract, paddle or mistral.
# - none: documents only yield the text stored in them, for scans at most the scanner's own OCR, if any.
# - tesseract: light on memory (about 0.5-1 GB per document being converted).
# - paddle: PaddleOCR, recognizes scans better but needs about twice the memory (1-2 GB per document).
#   The docker image includes its models for English, Latin languages and Chinese (about 40 MB); models
#   for other scripts, and all models outside docker, are downloaded from Hugging Face on first use.
# - mistral: Mistral's OCR API (needs OCR_API_KEY_MISTRAL), recognizes scans and their tables much better.
#   Documents with pages that look like scans are sent to Mistral as a whole, the others stay local.
# tesseract and paddle are only available when built with the local-ocr feature (the default).
# Changing it converts all documents again, one at a time.
OCR_ENGINE=none
# Comma-separated Tesseract language codes, e.g. deu,eng (also used for paddle, mistral detects the
# languages itself). Language data that is not installed is downloaded from GitHub on first use.
OCR_LANGUAGES=eng
# How likely a page must be a scan, from 0 to 1, to be recognized with OCR (optional).
# Changing it converts all documents again, one at a time.
OCR_SCAN_CONFIDENCE=0.5
# API key for OCR_ENGINE=mistral
OCR_API_KEY_MISTRAL=

# Host ports (optional)
API_PORT=3000

# The SQLite database file, created if missing (optional). Docker keeps it in the data volume.
# Relative paths are relative to the working directory.
DATABASE_URL=sqlite:rp.db

# Where repositories are cloned to, relative to the working directory. (optional)
REPOS_DIR=repos

# Where the files users drop into chats are stored, relative to the working directory. (optional)
ATTACHMENTS_DIR=attachments

# Serves the frontend under `/`. Unset serves only the API.
# FRONTEND_DIR=../web/.output/public
