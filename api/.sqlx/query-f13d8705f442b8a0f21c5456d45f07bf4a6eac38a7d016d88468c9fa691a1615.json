  "query": "SELECT d.path, e.status, e.markdown, e.error\n               FROM repository_documents d\n                        JOIN document_extractions e ON e.blob_oid = d.blob_oid\n               WHERE d.repository_id = $1 AND e.extractor <> 'seeded'\n               ORDER BY d.path",
