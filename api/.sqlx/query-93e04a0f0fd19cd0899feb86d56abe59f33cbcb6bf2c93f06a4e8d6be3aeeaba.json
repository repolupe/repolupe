  "query": "SELECT u.id AS \"user_id: Uuid\", u.user_name, u.email, ru.can_commit, ru.created_at AS \"created_at: DateTime<Utc>\"\n           FROM repository_users ru\n           JOIN users u ON u.id = ru.user_id\n           WHERE ru.repository_id = $1\n           ORDER BY ru.created_at, u.id",
